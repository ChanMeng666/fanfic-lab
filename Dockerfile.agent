# Dockerfile for LangGraph Agent Service
# Multi-stage build for minimal image size

# --- Stage 1: Install dependencies ---
FROM node:22.13.0-bookworm-slim AS deps

WORKDIR /app

# Install only agent-specific dependencies
COPY package.agent.json ./package.json
COPY prisma ./prisma
RUN npm install --legacy-peer-deps && npx prisma generate

# --- Stage 2: Production runner ---
FROM node:22.13.0-bookworm-slim AS runner

RUN apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=8123

# Copy dependencies from deps stage
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/package.json ./package.json

# Copy only the source files the agent needs
COPY src/agent ./src/agent
COPY src/knowledge ./src/knowledge
COPY src/lib/types ./src/lib/types
COPY src/lib/db.ts ./src/lib/db.ts
COPY src/lib/cloudinary.ts ./src/lib/cloudinary.ts
COPY tsconfig.json ./
COPY prisma ./prisma

EXPOSE 8123

CMD ["npm", "run", "start:agent"]
