# ===========================================
# FanFic Lab - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values

# Database (Neon PostgreSQL - auto-configured on Vercel)
DATABASE_URL="postgresql://user:password@host.neon.tech/fanficlab?sslmode=require"

# Auth (Stack Auth - Neon integration on Vercel)
STACK_SECRET_SERVER_KEY=""
NEXT_PUBLIC_STACK_PROJECT_ID=""
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=""

# AI - OpenAI (for story generation)
OPENAI_API_KEY="sk-..."

# AI - Google (for Gemini Imagen image generation)
GOOGLE_API_KEY=""

# CopilotKit
# For local development, use http://localhost:8123
# For production, use your deployed agent URL
LANGGRAPH_DEPLOYMENT_URL="http://localhost:8123"
# Optional: LangSmith for observability
LANGSMITH_API_KEY=""

# Vercel Blob Storage (for draft autosave)
BLOB_READ_WRITE_TOKEN=""

# Vercel KV / Redis (for caching, rate limiting)
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# Cloudinary (for image storage)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
