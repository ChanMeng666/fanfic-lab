{
  "project": "fanfic-lab",
  "baseUrl": "https://fanfic-lab.tech",
  "outDir": "docs/showcase",

  "viewports": {
    "desktop": { "width": 1280, "height": 800, "deviceScaleFactor": 2 },
    "mobile":  { "width": 390,  "height": 844, "deviceScaleFactor": 3, "isMobile": true }
  },

  "reducedMotion": "reduce",

  "pages": [
    {
      "label": "hero",
      "url": "/",
      "viewport": "desktop",
      "fullPage": false,
      "before": [
        { "action": "wait", "ms": 2500 }
      ]
    },
    {
      "label": "feed",
      "url": "/feed",
      "viewport": "desktop",
      "fullPage": false,
      "before": [
        { "action": "wait", "ms": 2000 }
      ]
    },
    {
      "label": "about",
      "url": "/about",
      "viewport": "desktop",
      "fullPage": false,
      "before": [
        { "action": "wait", "ms": 2000 }
      ]
    },
    {
      "label": "mobile-hero",
      "url": "/",
      "viewport": "mobile",
      "fullPage": false,
      "before": [
        { "action": "wait", "ms": 2500 }
      ]
    }
  ],

  "demo": {
    "size": { "width": 1280, "height": 720 },
    "stepPauseMs": 500,
    "steps": [
      { "action": "goto", "url": "/", "timeoutMs": 15000 },
      { "action": "wait", "ms": 2000 },
      { "action": "goto", "url": "/feed", "timeoutMs": 15000 },
      { "action": "wait", "ms": 1800 },
      { "action": "scroll", "by": 400 },
      { "action": "wait", "ms": 800 },
      { "action": "scroll", "by": 400 },
      { "action": "wait", "ms": 800 },
      { "action": "scroll", "by": -800 },
      { "action": "wait", "ms": 600 }
    ]
  }
}
