// FanFic Lab - Prisma Schema
// AI-powered fanfiction writing platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// USER & AUTHENTICATION
// ============================================

model User {
  id          String   @id @default(cuid())
  stackAuthId String   @unique // Stack Auth user ID
  email       String   @unique
  username    String   @unique
  displayName String?
  avatarUrl   String?
  bio         String?  @db.Text
  // Stripe customer id (created lazily on first checkout). Lets us reuse the
  // same customer across purchases so payment history is grouped in Stripe.
  stripeCustomerId String? @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  stories       Story[]
  characters    Character[]
  drafts        Draft[]
  likes         Like[]
  comments      Comment[]
  commentLikes  CommentLike[]
  follows       Follow[]      @relation("follower")
  followers     Follow[]      @relation("following")
  notifications Notification[]
  preferences   UserPreferences?
  generations   Generation[]
  credits       UserCredits?
  payments      Payment[]
  proposedBranches StoryBranch[] @relation("branchProposer")
  branchLikes      BranchLike[]
  bookmarks        Bookmark[]

  @@index([stackAuthId])
  @@index([email])
  @@index([username])
}

model UserPreferences {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  favoriteFandoms String[] // Array of fandom names
  favoriteShips   String[] // Array of ship tags
  preferredTags   String[] // Array of content tags
  aiPersonality   String   @default("helpful") // AI writing style preference
  darkMode        Boolean  @default(false)

  // DreamWriter preference learning
  preferredCPs    String[] // Learned from generation history
  preferredTropes String[] // e.g., ["现代AU", "甜饼", "ABO"]
  avoidTropes     String[] // e.g., ["主要角色死亡", "NTR"]
  tonePreference  String?  // e.g., "偏虐带HE", "纯甜"
  lengthPreference String? // "short" | "medium" | "long"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// STORIES & CONTENT
// ============================================

model Story {
  id            String      @id @default(cuid())
  title         String
  summary       String?     @db.Text
  fandom        String
  ships         String[]    // e.g., ["Drarry", "Harmony"]
  tags          String[]    // e.g., ["Fluff", "Angst", "Crack fic"]
  rating        Rating      @default(GENERAL)
  status        StoryStatus @default(DRAFT)
  // Serialization state, independent of `status` (visibility). A PUBLISHED
  // story can be 连载中 (isComplete=false) or 已完结 (isComplete=true) and stays
  // visible in the feed either way. Do NOT use ARCHIVED to mean "完结".
  isComplete    Boolean     @default(false)
  wordCount     Int         @default(0)
  viewCount     Int         @default(0)
  coverImageUrl String?
  embedding     Unsupported("vector(1536)")?

  // Community AI co-creation: when true, logged-in readers may propose
  // "what happens next" branch continuations. Authors can opt out per story.
  allowBranching Boolean @default(true)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  chapters    Chapter[]
  characters  StoryCharacter[]
  likes       Like[]
  bookmarks   Bookmark[]
  comments    Comment[]
  generations Generation[]
  branches    StoryBranch[]

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([fandom])
  @@index([authorId])
  @@index([status])
  @@index([createdAt])
  // Supports the default feed query: where status=PUBLISHED order by publishedAt desc.
  @@index([status, publishedAt])
}

enum Rating {
  GENERAL
  TEEN
  MATURE
  EXPLICIT
}

enum StoryStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Chapter {
  id            String @id @default(cuid())
  title         String?
  content       String @db.Text
  chapterNumber Int
  wordCount     Int    @default(0)
  authorNotes   String? @db.Text

  storyId String
  story   Story  @relation(fields: [storyId], references: [id], onDelete: Cascade)

  // Community branch continuations that fork off the end of this chapter.
  branches StoryBranch[] @relation("branchForkPoint")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storyId, chapterNumber])
  @@index([storyId])
}

model Draft {
  id          String  @id @default(cuid())
  title       String?
  content     String  @db.Text
  contentBlob String? // External URL for large drafts (if needed)
  fandom      String?
  ships       String[]
  tags        String[]

  // AI context preserved for continuation
  aiContext Json? // Stores character traits, plot points, etc.

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([updatedAt])
}

// ============================================
// CHARACTERS
// ============================================

model Character {
  id                String   @id @default(cuid())
  name              String
  fandom            String
  canonDescription  String?  @db.Text
  personalityTraits String[] // e.g., ["brave", "sarcastic", "loyal"]
  speechPatterns    String?  @db.Text // How they talk
  relationships     Json?    // Key relationships with other characters
  portraitUrl       String?  // Cloudinary URL
  isOriginal        Boolean  @default(false) // OC vs canon character

  creatorId String?
  creator   User?   @relation(fields: [creatorId], references: [id])

  stories StoryCharacter[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fandom])
  @@index([creatorId])
  @@index([name, fandom])
}

model StoryCharacter {
  id           String        @id @default(cuid())
  storyId      String
  story        Story         @relation(fields: [storyId], references: [id], onDelete: Cascade)
  characterId  String
  character    Character     @relation(fields: [characterId], references: [id])
  role         CharacterRole @default(MAIN)
  customTraits String[]      // Story-specific character modifications

  @@unique([storyId, characterId])
  @@index([storyId])
  @@index([characterId])
}

enum CharacterRole {
  MAIN
  SUPPORTING
  MINOR
  MENTIONED
}

// ============================================
// IMAGES
// ============================================

model Image {
  id          String    @id @default(cuid())
  url         String    // Cloudinary URL
  publicId    String    // Cloudinary public ID
  type        ImageType
  prompt      String?   @db.Text // AI generation prompt used

  // References (one will be set based on type)
  storyId     String?
  characterId String?

  createdAt DateTime @default(now())

  @@index([storyId])
  @@index([characterId])
  @@index([type])
}

enum ImageType {
  COVER
  CHARACTER_PORTRAIT
  SCENE_ILLUSTRATION
  BACKGROUND
}

// ============================================
// SOCIAL FEATURES
// ============================================

model Like {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storyId   String
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, storyId])
  @@index([storyId])
  @@index([userId])
}

// Save-for-later / reading list. Distinct from Like: Like is an appreciation
// signal (drives "popular" sorting + author 获赞 stats), while a Bookmark is a
// private "I want to come back to this" marker. Same shape as Like.
model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storyId   String
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, storyId])
  @@index([storyId])
  @@index([userId])
}

model Comment {
  id        String    @id @default(cuid())
  content   String    @db.Text
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  storyId   String
  story     Story     @relation(fields: [storyId], references: [id], onDelete: Cascade)
  parentId  String?   // For nested replies
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")
  likes     CommentLike[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([storyId])
  @@index([userId])
  @@index([parentId])
}

model CommentLike {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, commentId])
  @@index([commentId])
  @@index([userId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String    // recipient
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String    // "comment" | "reply" | "story_like" | "comment_like" | "follow" | "branch_proposed" | "branch_like" | "branch_canonized"
  payload   Json      // actor + context (storyId, storyTitle, commentId, snippet, etc.)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

// ============================================
// COMMUNITY AI CO-CREATION (互动续写 / 分支续写)
// ============================================

// A reader-proposed "what happens next" continuation, AI-written off a fork
// point. Branches live OUTSIDE the canonical Chapter table so they never
// pollute the main storyline — they only become a real Chapter when the
// author canonizes one (see canonizeBranch in src/lib/actions/branch.ts).
model StoryBranch {
  id      String @id @default(cuid())
  storyId String
  story   Story  @relation(fields: [storyId], references: [id], onDelete: Cascade)

  // Fork point. MVP forks only off a canonical chapter (parentChapterId set).
  // parentBranchId is reserved for deeper branch-off-branch trees (later).
  parentChapterId String?
  parentChapter   Chapter? @relation("branchForkPoint", fields: [parentChapterId], references: [id], onDelete: Cascade)
  parentBranchId  String?
  parentBranch    StoryBranch?  @relation("branchTree", fields: [parentBranchId], references: [id], onDelete: Cascade)
  childBranches   StoryBranch[] @relation("branchTree")

  // The reader who proposed this direction (and pays the credits / is attributed).
  proposerId String
  proposer   User   @relation("branchProposer", fields: [proposerId], references: [id], onDelete: Cascade)

  direction String  @db.Text   // the reader's "接下来会怎样" prompt
  title     String?            // AI-generated chapter title
  content   String  @db.Text   // AI-written candidate chapter (NOT a Chapter row)
  wordCount Int     @default(0)

  status BranchStatus @default(ACTIVE) // ACTIVE | CANONIZED | HIDDEN

  // Set when the author promotes this branch into the main storyline.
  canonizedChapterId String? @unique

  likes      BranchLike[]
  generation Generation?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storyId])
  @@index([parentChapterId])
  @@index([proposerId])
  @@index([storyId, status])
}

enum BranchStatus {
  ACTIVE
  CANONIZED
  HIDDEN
}

model BranchLike {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId  String
  branch    StoryBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([userId, branchId])
  @@index([branchId])
  @@index([userId])
}

// ============================================
// FANDOM METADATA (for discovery)
// ============================================

model Fandom {
  id          String   @id @default(cuid())
  name        String   @unique
  displayName String
  category    String   // e.g., "Anime & Manga", "Movies, TV & RPF"
  description String?  @db.Text
  imageUrl    String?
  storyCount  Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([storyCount])
}

model Tag {
  id          String  @id @default(cuid())
  name        String  @unique
  displayName String
  category    String? // e.g., "genre", "trope", "warning"
  description String?
  usageCount  Int     @default(0)

  @@index([category])
  @@index([usageCount])
}

// ============================================
// AI GENERATION & CREDITS
// ============================================

model Generation {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           GenerationType
  status         GenerationStatus @default(PENDING)
  request        Json             // StoryRequest
  plan           Json?            // WritingPlan (after planning stage)
  deliverable    Json?            // StoryDeliverable (after delivery)
  wordCount      Int              @default(0)
  tokensUsed     Int              @default(0)
  creditsCharged Int              @default(0)
  durationMs     Int?
  storyId        String?          // Link to saved Story if user saves it
  story          Story?           @relation(fields: [storyId], references: [id])
  // Link to the StoryBranch this generation produced (community branch续写).
  // Set only for reader-proposed branch continuations.
  branchId       String?          @unique
  branch         StoryBranch?     @relation(fields: [branchId], references: [id])
  createdAt      DateTime         @default(now())
  completedAt    DateTime?

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model UserCredits {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Int      @default(0)
  totalUsed Int      @default(0)
  updatedAt DateTime @updatedAt
}

// ============================================
// PAYMENTS (Stripe one-time credit packs)
// ============================================

// One row per Stripe Checkout Session. Created as `pending` when the user
// starts checkout, flipped to `paid` by the webhook once payment succeeds.
// The webhook is the source of truth for granting credits — never the client.
model Payment {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeSessionId       String    @unique // Stripe Checkout Session id
  stripePaymentIntentId String?            // Filled once payment completes
  packId                String             // Credit pack id (see lib/billing/packs.ts)
  amount                Int                // Charged amount in the smallest currency unit (cents / 分)
  currency              String    @default("usd")
  creditsGranted        Int                // Credits this purchase unlocked
  status                String    @default("pending") // "pending" | "paid" | "failed"
  createdAt             DateTime  @default(now())
  completedAt           DateTime?

  @@index([userId])
  @@index([stripeSessionId])
}

// Idempotency ledger for Stripe webhooks: Stripe may deliver the same event
// more than once. We insert eventId before processing; a duplicate insert
// (unique violation) means the event was already handled — skip it.
model StripeEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique // Stripe event id (evt_...)
  type        String           // e.g. "checkout.session.completed"
  processedAt DateTime @default(now())

  @@index([eventId])
}

enum GenerationType {
  STORY
  CONTINUATION
}

enum GenerationStatus {
  PENDING
  GENERATING
  COMPLETE
  FAILED
}

// ============================================
// KNOWLEDGE BASE (RAG for DreamWriter)
// ============================================

model KnowledgeChunk {
  id        String   @id @default(cuid())
  fandom    String   @default("hsr")
  content   String   @db.Text
  embedding Unsupported("vector(1536)")
  metadata  Json     // { chapter?, characters?, location?, version? }

  createdAt DateTime @default(now())

  @@index([fandom])
}

// ============================================
// RESEARCH CACHE (Cost optimization)
// ============================================

// Caches Tavily search + LLM summarization results
// to avoid repeated API calls for popular sources
model SourceResearchCache {
  id             String   @id @default(cuid())
  sourceName     String   // Original name: "Mo Dao Zu Shi"
  sourceType     String   // "novel", "anime", "manga", "game", etc.
  normalizedName String   @unique // Lowercase, trimmed: "mo dao zu shi"

  // Full research data as JSON (SourceResearchData type)
  researchData Json

  // Metadata for cache management
  searchCount    Int      @default(1) // Usage analytics
  lastAccessedAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Cache expiry: research older than 30 days may be refreshed
  @@index([normalizedName])
  @@index([sourceType])
  @@index([lastAccessedAt])
  @@index([searchCount])
}
